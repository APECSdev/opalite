---
import Base from '../layouts/Base.astro';
---

<Base title="Contracts — Opalite" description="Deploy and interact with Opalite smart contracts on Midnight.">
  <section class="py-20 px-4 max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-4">Contracts</h1>
    <p class="text-lg text-gray-400 mb-8">
      Deploy and interact with Opalite smart contracts on the Midnight network.
      Connect the <a href="https://chromewebstore.google.com/detail/1am/bphnkdkcnfhompoegfpgnkidcjfbojjp" class="text-blue-400 hover:underline">1AM wallet</a> — fees are sponsored, no dust or NIGHT required.
    </p>

    <!-- Wallet Section -->
    <div class="bg-gray-900 rounded-lg p-6 mb-6">
      <h2 class="text-xl font-semibold mb-3">Wallet</h2>
      <p id="wallet-status" class="text-gray-400 mb-3">Not connected</p>
      <div class="flex gap-3">
        <button id="connect-btn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
          Connect 1AM
        </button>
        <button id="sync-check-btn" class="bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">
          Check sync
        </button>
      </div>
    </div>

    <!-- Contract Section -->
    <div class="bg-gray-900 rounded-lg p-6 mb-6">
      <h2 class="text-xl font-semibold mb-3">Age Verification</h2>
      <p class="text-gray-400 mb-3">
        Zero-knowledge age-gating primitive. Prove 18+ without revealing birthdate.
        Increments a public counter per verification.
      </p>
      <div class="flex gap-3 flex-wrap mb-4">
        <button id="deploy-btn" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
          Deploy contract
        </button>
        <button id="call-btn" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded">
          Call verifyAge
        </button>
        <button id="copy-btn" class="bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">
          Copy address
        </button>
      </div>
      <p class="text-sm text-gray-400">Contract address: <span id="contract-address" class="font-mono">—</span></p>
      <p class="text-sm text-gray-400">Verified count: <span id="verified-count" class="font-mono">—</span></p>
    </div>

    <!-- Log Panel -->
    <div class="bg-gray-900 rounded-lg p-6">
      <h2 class="text-xl font-semibold mb-3">Log</h2>
      <div id="log" class="font-mono text-sm bg-black/50 rounded p-4 h-64 overflow-y-auto">
        <div class="text-gray-500">Waiting for actions...</div>
      </div>
    </div>
  </section>
</Base>

<script type="module">
  // ═══════════════════════════════════════════════════════════
  // NO TOP-LEVEL IMPORTS — all @midnight-ntwrk imports are
  // dynamic (inside function bodies). This ensures the script
  // ALWAYS executes even if SDK WASM packages fail to bundle.
  // The wallet connection needs ZERO imports.
  // ═══════════════════════════════════════════════════════════

  let connectedAPI = null;
  let contractAddress = null;

  // ── UI helpers ──
  function log(msg, level) {
    level = level || 'info';
    var prefix = { info: 'i', error: 'X', success: 'OK', warn: '!' }[level] || 'i';
    console.log('[opalite] ' + msg);
    var logEl = document.getElementById('log');
    if (logEl) {
      var time = new Date().toLocaleTimeString();
      var color = { info: 'color:#60a5fa', error: 'color:#f87171', success: 'color:#4ade80', warn: 'color:#fbbf24' }[level] || 'color:#60a5fa';
      var line = document.createElement('div');
      line.style.cssText = color;
      line.textContent = '[' + time + '] ' + prefix + ' ' + msg;
      logEl.appendChild(line);
      logEl.scrollTop = logEl.scrollHeight;
    }
  }

  function setStatus(id, text) {
    var el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  // ── Wallet detection ──
  function detectWallet() {
    log('Detecting wallet...');
    log('window.midnight: ' + (window.midnight ? 'exists' : 'NOT FOUND'));

    if (!window.midnight) {
      // Check alternative injection points
      var walletKeys = Object.keys(window).filter(function(k) {
        return /midnight|1am|wallet/i.test(k);
      });
      log('Wallet-related window keys: ' + (walletKeys.join(', ') || 'none'));
      log('window.cardano: ' + (window.cardano ? 'exists' : 'not found'));
      return null;
    }

    log('window.midnight keys: ' + Object.keys(window.midnight).join(', '));

    // Try multiple possible keys
    var keys = ['1am', '1AM', 'midnight', 'Midnight'];
    for (var i = 0; i < keys.length; i++) {
      var key = keys[i];
      if (window.midnight[key]) {
        log('Found wallet at window.midnight["' + key + '"]', 'success');
        var wallet = window.midnight[key];
        log('Wallet type: ' + typeof wallet);
        var ownKeys = Object.keys(wallet);
        log('Wallet own keys: ' + ownKeys.join(', '));
        var proto = Object.getPrototypeOf(wallet);
        if (proto) {
          var methods = Object.getOwnPropertyNames(proto).filter(function(n) { return n !== 'constructor'; });
          log('Wallet proto methods: ' + methods.join(', '));
        }
        return wallet;
      }
    }

    // Check if window.midnight itself is the wallet
    if (typeof window.midnight.connect === 'function' || typeof window.midnight.enable === 'function') {
      log('window.midnight IS the wallet directly');
      return window.midnight;
    }

    log('No wallet found in window.midnight', 'error');
    return null;
  }

  // ── Connect wallet ──
  async function connectWallet() {
    log('=== Connect clicked ===');
    try {
      var wallet = detectWallet();
      if (!wallet) {
        var msg = 'No wallet found. Make sure 1AM extension is installed and enabled.';
        log(msg, 'error');
        setStatus('wallet-status', msg);
        return;
      }

      // Try connect() first (per 1AM docs)
      if (typeof wallet.connect === 'function') {
        log('Trying wallet.connect("preprod")...');
        try {
          connectedAPI = await wallet.connect('preprod');
          log('connect("preprod") succeeded!', 'success');
        } catch (e) {
          log('connect("preprod") failed: ' + e.message, 'warn');
          log('Trying wallet.connect() without args...');
          connectedAPI = await wallet.connect();
          log('connect() succeeded!', 'success');
        }
      } else if (typeof wallet.enable === 'function') {
        log('Trying wallet.enable()...');
        connectedAPI = await wallet.enable();
        log('enable() succeeded!', 'success');
      } else {
        var msg2 = 'Wallet has no connect() or enable() method';
        log(msg2, 'error');
        setStatus('wallet-status', msg2);
        return;
      }

      if (connectedAPI) {
        log('connectedAPI type: ' + typeof connectedAPI);
        if (typeof connectedAPI === 'object' && connectedAPI) {
          log('connectedAPI own keys: ' + Object.keys(connectedAPI).join(', '));
          var cproto = Object.getPrototypeOf(connectedAPI);
          if (cproto) {
            var cmethods = Object.getOwnPropertyNames(cproto).filter(function(n) { return n !== 'constructor'; });
            log('connectedAPI methods: ' + cmethods.join(', '));
          }
        }

        // Try to get configuration
        if (typeof connectedAPI.getConfiguration === 'function') {
          try {
            var config = await connectedAPI.getConfiguration();
            log('Network: ' + config.networkId, 'success');
            log('Indexer: ' + config.indexerUri, 'success');
            log('Prover: ' + config.proverServerUri, 'success');
            log('Substrate: ' + config.substrateNodeUri, 'success');
          } catch (e) {
            log('getConfiguration() failed: ' + e.message, 'warn');
          }
        }

        // Try to get addresses
        if (typeof connectedAPI.getShieldedAddresses === 'function') {
          try {
            var addrs = await connectedAPI.getShieldedAddresses();
            log('Shielded addresses: ' + JSON.stringify(addrs), 'success');
          } catch (e) {
            log('getShieldedAddresses() failed: ' + e.message, 'warn');
          }
        }

        setStatus('wallet-status', 'Connected');
        log('Wallet connected successfully!', 'success');
      } else {
        log('Connection returned null/undefined', 'error');
        setStatus('wallet-status', 'Connection returned null');
      }
    } catch (err) {
      log('Connection error: ' + err.message, 'error');
      if (err.stack) log('Stack: ' + err.stack, 'error');
      setStatus('wallet-status', 'Error: ' + err.message);
    }
  }

  // ── Build providers (from 1AM docs) ──
  async function buildProviders(api) {
    log('Building providers...');
    var config = await api.getConfiguration();
    log('Network ID: ' + config.networkId);

    var networkMod = await import('@midnight-ntwrk/midnight-js-network-id');
    networkMod.setNetworkId(config.networkId);
    log('Network ID set');

    var zkMod = await import('@midnight-ntwrk/midnight-js-fetch-zk-config-provider');
    var zkConfigProvider = new zkMod.FetchZkConfigProvider(
      window.location.origin + '/contract/compiled/age_verification',
      fetch.bind(window),
    );
    log('zkConfigProvider created');

    var indexerMod = await import('@midnight-ntwrk/midnight-js-indexer-public-data-provider');
    var publicDataProvider = indexerMod.indexerPublicDataProvider(
      config.indexerUri,
      config.indexerWsUri,
    );
    log('publicDataProvider created');

    var provingProvider = await api.getProvingProvider(zkConfigProvider);
    log('provingProvider acquired');

    var ledgerMod = await import('@midnight-ntwrk/ledger-v8');
    var CostModel = ledgerMod.CostModel;
    var Transaction = ledgerMod.Transaction;

    var proofProvider = {
      proveTx: async function(unprovenTx) {
        log('Proving transaction...');
        return unprovenTx.prove(provingProvider, CostModel.initialCostModel());
      },
    };

    var shieldedAddrResult = null;
    for (var attempt = 1; attempt <= 60; attempt++) {
      try {
        shieldedAddrResult = await api.getShieldedAddresses();
        log('getShieldedAddresses() succeeded on attempt ' + attempt, 'success');
        break;
      } catch (e) {
        log('getShieldedAddresses() attempt ' + attempt + '/60: ' + e.message, 'warn');
        if (attempt < 60) {
          log('Waiting 15s for wallet sync to finish...', 'warn');
          await new Promise(function(r) { setTimeout(r, 15000); });
        }
      }
    }
    if (!shieldedAddrResult) {
      throw new Error('Cannot get shielded addresses — wallet still syncing after 15 minutes. Please wait for 1AM to finish syncing and try again.');
    }
    log('Shielded address result: ' + JSON.stringify(shieldedAddrResult));

    // Handle different shapes
    var shieldedAddress = shieldedAddrResult;
    if (shieldedAddrResult.shieldedAddress) {
      shieldedAddress = shieldedAddrResult.shieldedAddress;
    }
    log('Shielded address object: ' + JSON.stringify(shieldedAddress));

    var walletProvider = {
      getCoinPublicKey: function() { return shieldedAddress.shieldedCoinPublicKey; },
      getEncryptionPublicKey: function() { return shieldedAddress.shieldedEncryptionPublicKey; },
      balanceTx: async function(tx) {
        log('Balancing transaction (ProofStation sponsors fees)...');
        var serialized = tx.serialize();
        var hex = Array.from(serialized).map(function(b) {
          return b.toString(16).padStart(2, '0');
        }).join('');
        var result = await api.balanceUnsealedTransaction(hex);
        var bytes = new Uint8Array(result.tx.match(/.{2}/g).map(function(b) {
          return parseInt(b, 16);
        }));
        return Transaction.deserialize('signature', 'proof', 'binding', bytes);
      },
    };

    var midnightProvider = {
      submitTx: async function(tx) {
        log('Submitting transaction to network...');
        var serialized = tx.serialize();
        var hex = Array.from(serialized).map(function(b) {
          return b.toString(16).padStart(2, '0');
        }).join('');
        await api.submitTransaction(hex);
        return tx.identifiers()[0];
      },
    };

    log('All providers built', 'success');
    return {
      publicDataProvider: publicDataProvider,
      zkConfigProvider: zkConfigProvider,
      proofProvider: proofProvider,
      walletProvider: walletProvider,
      midnightProvider: midnightProvider,
    };
  }

  // ── Build compiled contract ──
  async function buildCompiledContract() {
    log('Loading compact-js...');
    var ccMod = await import('@midnight-ntwrk/compact-js');
    var CompiledContract = ccMod.CompiledContract;
    log('compact-js loaded, CompiledContract keys: ' + Object.keys(CompiledContract).join(', '));

    log('Loading contract module...');
    var contractModule = await import('../contracts/age_verification.contract.js');
    var Contract = contractModule.Contract;
    log('Contract class: ' + (Contract ? Contract.name : 'null'));

    var ZK_BASE = '/contract/compiled/age_verification';
    log('Building compiled contract (make + withCompiledFileAssets + withVacantWitnesses)...');

    var cc = CompiledContract.make('age_verification', Contract);
    log('make() done, type: ' + typeof cc);

    var withAssets = CompiledContract.withCompiledFileAssets(ZK_BASE);
    log('withCompiledFileAssets() done, type: ' + typeof withAssets);

    var ccWithAssets = withAssets(cc);
    log('withAssets(cc) done, type: ' + typeof ccWithAssets);

    var compiled = CompiledContract.withVacantWitnesses(ccWithAssets);
    log('withVacantWitnesses() done, type: ' + typeof compiled);
    log('Compiled contract built', 'success');

    return compiled;
  }

  // ── Deploy contract ──
  async function deployContractHandler() {
    log('=== Deploy clicked ===');
    if (!connectedAPI) {
      log('Please connect wallet first', 'error');
      return;
    }

    try {
      var compiledContract = await buildCompiledContract();

      log('Loading midnight-js-contracts...');
      var contractsMod = await import('@midnight-ntwrk/midnight-js-contracts');
      log('midnight-js-contracts loaded, exports: ' + Object.keys(contractsMod).slice(0, 15).join(', '));

      var providers = await buildProviders(connectedAPI);

      log('Calling deployContract...');
      log('providers keys: ' + Object.keys(providers).join(', '));

      // Try passing compiledContract in options
      var deployed;
      try {
        deployed = await contractsMod.deployContract(providers, {
          compiledContract: compiledContract,
        });
      } catch (e1) {
        log('deployContract with options failed: ' + e1.message, 'warn');
        log('Trying with providers spread + compiledContract...');
        deployed = await contractsMod.deployContract(
          Object.assign({}, providers, { compiledContract: compiledContract }),
          {}
        );
      }

      contractAddress = deployed.deployTxData.publicContractAddress;
      log('Contract deployed! Address: ' + contractAddress, 'success');
      setStatus('wallet-status', 'Connected — Contract deployed');
      var addrEl = document.getElementById('contract-address');
      if (addrEl) addrEl.textContent = contractAddress;

      // Try to get verified count
      try {
        var states = await contractsMod.getPublicStates(providers, compiledContract, contractAddress);
        log('Public states: ' + JSON.stringify(states), 'success');
        var countEl = document.getElementById('verified-count');
        if (countEl && states && states.verifiedCount) {
          countEl.textContent = String(states.verifiedCount);
        }
      } catch (e2) {
        log('getPublicStates failed: ' + e2.message, 'warn');
      }
    } catch (err) {
      log('Deploy error: ' + err.message, 'error');
      if (err.stack) log('Stack: ' + err.stack, 'error');
      setStatus('wallet-status', 'Connected — Deploy failed');
    }
  }

  // ── Call verifyAge ──
  async function callVerifyAge() {
    log('=== Call verifyAge clicked ===');
    if (!connectedAPI) {
      log('Please connect wallet first', 'error');
      return;
    }
    if (!contractAddress) {
      log('Please deploy contract first', 'error');
      return;
    }

    try {
      var compiledContract = await buildCompiledContract();

      log('Loading midnight-js-contracts...');
      var contractsMod = await import('@midnight-ntwrk/midnight-js-contracts');

      var providers = await buildProviders(connectedAPI);

      log('Available contract functions: ' + Object.keys(contractsMod).filter(function(k) {
        return /call|tx|submit/i.test(k);
      }).join(', '));

      // Try submitCallTx with different option shapes
      log('Creating call transaction for verifyAge circuit...');

      // Get the circuit ID from the compiled contract
      var circuitIds = contractsMod.getProvableCircuitIds ? contractsMod.getProvableCircuitIds(compiledContract) : [];
      log('Circuit IDs: ' + JSON.stringify(circuitIds));

      var callOptions = {
        contractAddress: contractAddress,
      };

      // Try to set the circuit — the compiled contract should have circuit info
      log('Attempting submitCallTx...');
      var result = await contractsMod.submitCallTx(providers, callOptions);
      log('Call succeeded! Result: ' + JSON.stringify(result), 'success');

      // Update verified count
      try {
        var states = await contractsMod.getPublicStates(providers, compiledContract, contractAddress);
        log('Updated states: ' + JSON.stringify(states), 'success');
        var countEl = document.getElementById('verified-count');
        if (countEl && states && states.verifiedCount) {
          countEl.textContent = String(states.verifiedCount);
        }
      } catch (e) {
        log('getPublicStates failed: ' + e.message, 'warn');
      }
    } catch (err) {
      log('Call error: ' + err.message, 'error');
      if (err.stack) log('Stack: ' + err.stack, 'error');
    }
  }

  // ── Copy address ──
  function copyAddress() {
    if (contractAddress) {
      navigator.clipboard.writeText(contractAddress);
      log('Address copied to clipboard', 'success');
    } else {
      log('No contract address to copy', 'warn');
    }
  }

  // ── Check sync status ──
  async function checkSync() {
    log('=== Check sync clicked ===');
    if (!connectedAPI) {
      log('Not connected. Click Connect first.', 'error');
      return;
    }
    try {
      if (typeof connectedAPI.getConnectionStatus === 'function') {
        var status = await connectedAPI.getConnectionStatus();
        log('Connection status: ' + JSON.stringify(status), 'success');
      } else {
        log('getConnectionStatus not available', 'warn');
      }
      // Also try getShieldedAddresses to see if sync is done
      try {
        var addrs = await connectedAPI.getShieldedAddresses();
        log('getShieldedAddresses() works now! Wallet is synced.', 'success');
        log('Shielded addresses: ' + JSON.stringify(addrs), 'success');
      } catch (e) {
        log('getShieldedAddresses() still failing: ' + e.message, 'warn');
        log('Wallet is still syncing. Keep waiting.', 'warn');
      }
    } catch (err) {
      log('Check sync error: ' + err.message, 'error');
    }
  }

  // ── Init — NO IMPORTS NEEDED HERE ──
  console.log('[opalite] Contracts page script loaded (no top-level imports)');

  var connectBtn = document.getElementById('connect-btn');
  var deployBtn = document.getElementById('deploy-btn');
  var callBtn = document.getElementById('call-btn');
  var copyBtn = document.getElementById('copy-btn');

  if (connectBtn) connectBtn.addEventListener('click', connectWallet);
  if (deployBtn) deployBtn.addEventListener('click', deployContractHandler);
  if (callBtn) callBtn.addEventListener('click', callVerifyAge);
  if (copyBtn) copyBtn.addEventListener('click', copyAddress);
  var syncBtn = document.getElementById('sync-check-btn');
  if (syncBtn) syncBtn.addEventListener('click', checkSync);

  log('Page loaded. Click "Connect 1AM" to begin.');
  log('window.midnight: ' + (window.midnight ? 'exists' : 'not found'));

  if (window.midnight) {
    log('window.midnight keys: ' + Object.keys(window.midnight).join(', '));
  } else {
    log('1AM extension not detected. Install from Chrome Web Store.', 'warn');
  }
</script>
